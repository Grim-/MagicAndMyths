<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <AbilityDef>
    <defName>MagicAndMyths_Pyroball</defName>
    <label>Pyroball</label>
    <description>Many big boom</description>
    <iconPath>Projectiles/FireRain</iconPath>
    <cooldownTicksRange>8600</cooldownTicksRange>
    <category>Sanguophage</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>45</range>
      <warmupTime>1</warmupTime>
      <soundCast>PiercingSpine_Launch</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetItems>true</canTargetItems>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MagicAndMyths.CompProperties_LaunchProjectileExtended">
        <projectileDef>Projectile_Pyroball</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseMagicProjectile">
    <defName>Projectile_Pyroball</defName>
    <label>fireball</label>
    <thingClass>MagicAndMyths.Projectile_Extended</thingClass>
    <graphicData>
      <texPath>Projectiles/Projectile_Fireball</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>20</damageAmountBase>
      <speed>50</speed>
      <arcHeightFactor>2</arcHeightFactor>
    </projectile>
    <comps>
      <li Class="MagicAndMyths.ProjectileCompProperties_ImpactAOEDamage">
        <damageDef>Burn</damageDef>
        <effecterDef>MagicAndMyths_Explosion</effecterDef>
        <damageAmount>5</damageAmount>
        <radius>8</radius>
      </li>
      <li Class="MagicAndMyths.ProjectileCompProperties_ImpactStartOrStopFires">
          <effecterDef>MagicAndMyths_ExplosionThree</effecterDef>
      </li>
      <li Class="MagicAndMyths.ProjectileCompProperties_ImpactCameraShake">
      </li>
      <li Class="MagicAndMyths.ProjectileCompProperties_ImpactSubProjectiles">
        <projectileDefs>
          <li>Projectile_Firebolt</li>
        </projectileDefs>
        <friendlyFireSettings>
          <canTargetHostile>true</canTargetHostile>
          <canTargetFriendly>true</canTargetFriendly>
        </friendlyFireSettings>
        <targetSeekRadius>10</targetSeekRadius>
      </li>
    </comps>
  </ThingDef>
</Defs>
