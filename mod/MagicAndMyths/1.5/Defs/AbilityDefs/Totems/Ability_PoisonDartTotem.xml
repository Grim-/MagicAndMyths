<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <AbilityDef>
    <defName>MagicAndMyths_PlacePoisonDartTotem</defName>
    <label>totem : poison dart</label>
    <description>Place a totem that fires poison darts inflicting toxic damage at a target in range.</description>
    <iconPath>Skills/Fly</iconPath>
    <hostile>false</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>45</range>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MagicAndMyths.CompProperties_AbilitySpawnTotem">
        <totemDef>MM_PoisonDartTotem</totemDef>
      </li>
    </comps>
  </AbilityDef>

  <MagicAndMyths.TotemDef ParentName="BaseTotem">
    <defName>MM_PoisonDartTotem</defName>
    <label>poison dart totem</label>
    <description>Fires poison darts inflicting toxic damage at a target in range.</description>
    <thingClass>MagicAndMyths.Building_Totem</thingClass>
    <lifetimeTicks>2500</lifetimeTicks>
    <effectRadius>10</effectRadius>
    <graphicData>
      <texPath>Totems/TotemTribal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.3, 0.3, 0.3)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <blockWind>false</blockWind>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <designationCategory>Misc</designationCategory>
    <comps>
      <li Class="MagicAndMyths.CompProperties_TotemTurret">
        <projectileDef>Projectile_PoisonDart</projectileDef>
        <turretFireEffect>Deflect_Metal</turretFireEffect>
        <tickInterval>250</tickInterval>
        <friendlyFireSettings>
          <canTargetHostile>true</canTargetHostile>
          <canTargetFriendly>false</canTargetFriendly>
          <canTargetNeutral>false</canTargetNeutral>
        </friendlyFireSettings>
      </li>
    </comps>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </MagicAndMyths.TotemDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Projectile_PoisonDart</defName>
    <label>poison dart</label>
    <graphicData>
      <texPath>Projectiles/Projectile_PoisonDart</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Acid</damageDef>
      <damageAmountBase>10</damageAmountBase>
      <speed>50</speed>
      <armorPenetrationBase>1</armorPenetrationBase>
    </projectile>
  </ThingDef>
</Defs>
