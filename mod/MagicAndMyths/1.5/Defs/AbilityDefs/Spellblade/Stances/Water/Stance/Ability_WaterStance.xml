<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicAndMyths.StanceDef>
    <defName>Spellblade_WaterStance</defName>
    <label>Water Stance</label>
    <description>Defensive stance providing healing and protection. Increases dodge and provides regeneration.</description>
    <iconPath>Skills/Spellblade/Skill_WaterArmour</iconPath>
    <iconColor>(0.2, 0.6, 1)</iconColor>
    <cooldownTicks>300</cooldownTicks>
    <upkeepCost>5</upkeepCost>
    <hediffsToApply>
      <li>Spellblade_WaterStanceHediff</li>
    </hediffsToApply>
    <abilitiesToGain>
      <li>MagicAndMyths_SoothingVapours</li>
      <li>MagicAndMyths_WaterSurge</li>
      <li>MagicAndMyths_ElementalArmour_Water</li>
    </abilitiesToGain>
  </MagicAndMyths.StanceDef>

  <MagicAndMyths.ResourceAbilityDef ParentName="MagicAndMyths_BaseStance">
    <defName>Spellblade_ToggleWaterStance</defName>
    <label>Water Stance</label>
    <description>Toggle the defensive water stance on or off.</description>
    <iconPath>Skills/Spellblade/Skill_WaterArmour</iconPath>
    <cooldownTicksRange>0</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <warmupTime>0</warmupTime>
      <soundCast>FireSpew_Resolve</soundCast>
      <targetable>False</targetable>
      <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
    </verbProperties>
    <comps>
      <li Class="MagicAndMyths.CompProperties_AbilityToggleStance">
        <stance>Spellblade_WaterStance</stance>
        <allowDeactivation>true</allowDeactivation>
      </li>
    </comps>
  </MagicAndMyths.ResourceAbilityDef>

  <HediffDef>
    <defName>Spellblade_WaterStanceHediff</defName>
    <label>Water Stance</label>
    <description>Channeling protective water magic. Provides defensive bonuses and regeneration.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <MeleeDodgeChance>0.15</MeleeDodgeChance>
          <ComfyTemperatureMin>-5</ComfyTemperatureMin>
          <ComfyTemperatureMax>5</ComfyTemperatureMax>
        </statOffsets>
        <statFactors>
          <Stat_ManaRegen>1.15</Stat_ManaRegen>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="MagicAndMyths.HediffCompProperties_EffecterMaintainer">
        <effecterDef>MagicAndMyths_WaterStanceAura</effecterDef>
      </li>
    </comps>
  </HediffDef>

</Defs>
