<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicAndMyths.StanceDef>
    <defName>Spellblade_EarthStance</defName>
    <label>Earth Stance</label>
    <description>Defensive stance focused on armor and area damage. Slow but powerful cleaving attacks.</description>
    <iconPath>Skills/Spellblade/Skill_EarthArmour</iconPath>
    <iconColor>(0.6, 0.4, 0.2)</iconColor>
    <cooldownTicks>300</cooldownTicks>
    <upkeepCost>10</upkeepCost>
    <hediffsToApply>
      <li>Spellblade_EarthStanceHediff</li>
    </hediffsToApply>
    <abilitiesToGain>
      <li>MagicAndMyths_ElementalArmour_Earth</li>
      <li>MagicAndMyths_EarthenHammer</li>
      <li>MagicAndMyths_EarthenStomp</li>
    </abilitiesToGain>
  </MagicAndMyths.StanceDef>

  <MagicAndMyths.ResourceAbilityDef>
    <defName>Spellblade_ToggleEarthStance</defName>
    <label>Earth Stance</label>
    <description>Toggle the defensive earth stance on or off.</description>
    <iconPath>Skills/Spellblade/Skill_EarthArmour</iconPath>
    <cooldownTicksRange>0</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <resourceCost>20</resourceCost>
    <resourceDef>Mana</resourceDef>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <warmupTime>0</warmupTime>
      <soundCast>FireSpew_Resolve</soundCast>
      <targetable>False</targetable>
      <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
    </verbProperties>
    <comps>
      <li Class="MagicAndMyths.CompProperties_AbilityToggleStance">
        <stance>Spellblade_EarthStance</stance>
        <allowDeactivation>true</allowDeactivation>
      </li>
    </comps>
  </MagicAndMyths.ResourceAbilityDef>

  <HediffDef>
    <defName>Spellblade_EarthStanceHediff</defName>
    <label>Earth Stance</label>
    <description>Channeling solid earth magic. Provides heavy armor but reduces mobility.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
          <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
          <MeleeDodgeChance>-0.4</MeleeDodgeChance>
          <MeleeCooldownFactor>-0.2</MeleeCooldownFactor>
        </statOffsets>
        <statFactors>
          <MoveSpeed>0.25</MoveSpeed>
          <ArmorRating_Blunt>1.05</ArmorRating_Blunt>
          <ArmorRating_Sharp>1.05</ArmorRating_Sharp>
          <Stat_ManaRegen>0.80</Stat_ManaRegen>
          <Stat_LimbMaxHP>2</Stat_LimbMaxHP>
          <Flammability>0.4</Flammability>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="MagicAndMyths.HediffCompProperties_OnMeleeAttackDealCleaveDamage">
      </li>
      <li Class="MagicAndMyths.HediffCompProperties_OnMeleeAttackAddHediff">
        <hediffDef>MudInEyes</hediffDef>
        <intialSeverity>0.1</intialSeverity>
        <severityIncrease>0.1</severityIncrease>
        <chanceToApply>0.5</chanceToApply>
      </li>
    </comps>
  </HediffDef>


</Defs>
