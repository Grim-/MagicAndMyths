<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <AbilityDef>
    <defName>MagicAndMyths_EarthenStomp</defName>
    <label>Earthen Stomp</label>
    <description>Stomp down into the ground sending out a shockwave stunning all enemies in range.</description>
    <iconPath>Projectiles/Projectile_Fireball</iconPath>
    <cooldownTicksRange>6000</cooldownTicksRange>
    <category>Sanguophage</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>3</range>
      <warmupTime>0</warmupTime>
      <soundCast>FireSpew_Resolve</soundCast>
      <targetable>False</targetable>
      <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
    </verbProperties>
    <comps>
      <li Class="MagicAndMyths.CompProperties_AbilityStunInRadius">
        <radius>3</radius>
        <stunTicks>100~200</stunTicks>
      </li>
      <li Class="MagicAndMyths.CompProperties_ThrowFilthInRadius">
        <radius>3</radius>
        <filthDef>Filth_Fuel</filthDef>
        <chance>0.6~1</chance>
      </li>
      <li Class="MagicAndMyths.CompProperties_AbilityDamageInRadius">
        <radius>3</radius>
        <damageDef>Blunt</damageDef>
        <damage>1~2</damage>
      </li>

    </comps>
  </AbilityDef>

</Defs>
