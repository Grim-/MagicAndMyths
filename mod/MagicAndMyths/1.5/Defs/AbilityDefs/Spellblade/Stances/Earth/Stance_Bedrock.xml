<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicAndMyths.StanceDef>
      <defName>Spellblade_EarthStance</defName>
      <label>Bedrock Form</label>
      <description>Defensive stance channeling earth magic. Provides heavy armor and cleaving attacks at the cost of mobility. Melee attacks hit all enemies in a cone with a chance to blind them with mud.</description>
      <iconPath>Skills/Spellblade/Skill_EarthArmour</iconPath>
      <iconColor>(0.6, 0.4, 0.2)</iconColor>
      <cooldownTicks>300</cooldownTicks>
      <upkeepCost>10</upkeepCost>
      <hediffsToApply>
        <li>Spellblade_EarthStanceHediff</li>
      </hediffsToApply>
      <abilitiesToGain>
        <li>MagicAndMyths_ElementalArmour_Earth</li>
        <li>MagicAndMyths_FaultBreak</li>
        <li>MagicAndMyths_EarthenStomp</li>
      </abilitiesToGain>
      <hediffsToRemoveOnExit>
        <li>Spellblade_EarthArmourHediff</li>
      </hediffsToRemoveOnExit>
    </MagicAndMyths.StanceDef>

</Defs>
