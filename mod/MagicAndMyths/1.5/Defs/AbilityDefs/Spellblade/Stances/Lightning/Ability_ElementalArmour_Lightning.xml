<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicAndMyths.ResourceAbilityDef ParentName="MagicAndMyths_BaseStance">
    <defName>MagicAndMyths_ElementalArmour_Lightning</defName>
    <label>Elemental Armour : Lightning</label>
    <description>Gain Lightning Armour</description>
    <iconPath>UI/Abilities/Spellblade/EarthStance</iconPath>
    <cooldownTicksRange>3000</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <resourceCost>20</resourceCost>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <warmupTime>0</warmupTime>
      <soundCast>FireSpew_Resolve</soundCast>
      <targetable>False</targetable>
      <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
    </verbProperties>
    <comps>
      <li Class="MagicAndMyths.CompProperties_AbilityAddStacks">
        <hediffDef>Spellblade_LightningArmorHediff</hediffDef>
        <stacksToGive>1</stacksToGive>
      </li>
    </comps>
  </MagicAndMyths.ResourceAbilityDef>

  <MagicAndMyths.StackingHediffDef>
    <defName>Spellblade_LightningArmorHediff</defName>
    <label>LightningArmor</label>
    <description>LightningArmor</description>
    <maxSeverity>1.0</maxSeverity>
    <maxStacks>10</maxStacks>
    <isBad>false</isBad>
    <stages>
    </stages>
    <comps>
      <li Class="MagicAndMyths.HediffCompProperties_LightningArmour">
        <ticksPerStackGain>250</ticksPerStackGain>
        <stacksToRemoveOnHit>1</stacksToRemoveOnHit>
        <triggerDamageTypes>
          <li>Blunt</li>
          <li>Cut</li>
        </triggerDamageTypes>
        <minimumDamageToTrigger>1</minimumDamageToTrigger>
        <buffToGrantOnHit>Spellblade_LightningSpeedBuff</buffToGrantOnHit>
        <buffDurationTicks>300</buffDurationTicks>
        <stunDurationTicks>60</stunDurationTicks>
        <stunChance>1.0</stunChance>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1250</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="MagicAndMyths.HediffCompProperties_EffecterMaintainer">
        <effecterDef>MagicAndMyths_LightningSparks</effecterDef>
      </li>
    </comps>
  </MagicAndMyths.StackingHediffDef>

  <HediffDef>
    <defName>Spellblade_LightningSpeedBuff</defName>
    <label>lightning speed</label>
    <labelNoun>lightning speed</labelNoun>
    <description>Crackling with electrical energy, movement is greatly enhanced.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.9, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>0.5</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
</Defs>
