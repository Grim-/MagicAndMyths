<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <AbilityDef>
    <defName>MagicAndMyths_LightningSpear</defName>
    <label>Lightning Spear</label>
    <description>Hurl a crackling spear of lightning toward the target location, damaging all enemies in its path. Upon impact, it creates an electrified zone that slows enemies and accelerates allies. Targets taking lightning damage within the zone trigger additional lightning strikes.</description>
    <iconPath>Projectiles/Projectile_Fireball</iconPath>
    <cooldownTicksRange>6000</cooldownTicksRange>
    <category>Sanguophage</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>20</range>
      <warmupTime>0.5</warmupTime>
      <soundCast>PiercingSpine_Launch</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetItems>true</canTargetItems>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MagicAndMyths.CompProperties_AbilityDamageInRect">
        <length>20</length>
        <width>3</width>
        <damage>5</damage>
        <damageDef>Cut</damageDef>
        <effectMote>MagicAndMyths_LightningSpear</effectMote>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="MoteBase">
      <defName>MagicAndMyths_LightningSpear</defName>
      <thingClass>MoteDualAttached</thingClass>
      <graphicData>
        <graphicClass>Graphic_Mote</graphicClass>
        <shaderType>MoteGlow</shaderType>
        <texPath>VFX/TrailElectricAlt</texPath>
        <color>(0.929, 1, 0, 1)</color>
      </graphicData>
      <altitudeLayer>Filth</altitudeLayer>
      <mote>
        <fadeInTime>0.1</fadeInTime>
        <solidTime>1</solidTime>
        <fadeOutTime>0</fadeOutTime>
        <growthRate>0</growthRate>
        <rotateTowardsTarget>True</rotateTowardsTarget>
        <scaleToConnectTargets>false</scaleToConnectTargets>
      </mote>
    </ThingDef>
</Defs>
