<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicAndMyths.ResourceToggleAbilityDef ParentName="MagicAndMyths_BaseStance">
    <defName>MagicAndMyths_ElementalArmour_Fire</defName>
    <label>Elemental Armour : Fire</label>
    <description>Toggle your fire aura on or off. When active, flames surround the caster, dealing fire damage with a chance of burning melee attackers.</description>
    <iconPath>UI/Abilities/Spellblade/FireStance</iconPath>
    <resourceDef>Mana</resourceDef>
    <resourceCost>25</resourceCost>
    <resourceMaintainCost>15</resourceMaintainCost>
    <cooldownTicksRange>0</cooldownTicksRange>
    <aiCanUse>false</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0</range>
      <warmupTime>0</warmupTime>
      <soundCast>FireSpew_Resolve</soundCast>
      <targetable>False</targetable>
      <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
    </verbProperties>
    <comps>
      <li Class="MagicAndMyths.CompProperties_ResourceToggleHediff">
        <hediffDef>SpellBlade_ElementalArmour_Fire</hediffDef>
      </li>
    </comps>
  </MagicAndMyths.ResourceToggleAbilityDef>
  
  <HediffDef>
    <defName>SpellBlade_ElementalArmour_Fire</defName>
    <label>fire armor</label>
    <labelNoun>fire armor</labelNoun>
    <description>Wreathed in protective flames that burn attackers who dare strike in melee.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.4, 0.0)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <comps>
      <li Class="MagicAndMyths.HediffCompProperties_MoteMaintainer">
        <moteDef>MagicAndMyths_FireStanceAura</moteDef>
      </li>
      <li Class="MagicAndMyths.HediffCompProperties_DealDamageToAttacker">
        <damageDef>Flame</damageDef>
        <damage>3~8</damage>
        <meleeRangeOnly>true</meleeRangeOnly>
        <triggerDamageTypes>
          <li>Blunt</li>
          <li>Cut</li>
        </triggerDamageTypes>
        <minimumDamageToTrigger>1</minimumDamageToTrigger>
      </li>
      <li Class="MagicAndMyths.HediffCompProperties_ApplyHediffToAttacker">
        <hediffToApply>Burn</hediffToApply>
        <chance>0.6</chance>
        <severity>0.2~0.4</severity>
        <meleeRangeOnly>true</meleeRangeOnly>
        <triggerDamageTypes>
          <li>Blunt</li>
          <li>Cut</li>
        </triggerDamageTypes>
        <minimumDamageToTrigger>1</minimumDamageToTrigger>
      </li>
    </comps>
  </HediffDef>
</Defs>
