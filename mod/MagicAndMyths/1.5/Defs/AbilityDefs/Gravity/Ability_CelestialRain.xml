<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Everything I edited anything for this is in this xml-->\
  <!-- Note an ability that is a hold in place should be the next one, like WindCutter/Cooking Pot-->
  <!-- this ability will no doubt change but the idea is shooting stars? or orbs of gravity -->
  <AbilityDef>
    <defName>MagicAndMyths_CelestialRain</defName>
    <label>Celestial Rain</label>
    <description>Celestial Rain.</description>
    <iconPath>Projectiles/FireRain</iconPath>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <drawAimPie>true</drawAimPie>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MagicAndMyths.CompProperties_SpawnProjectileProxy">
        <portalDef>MagicAndMyths_ProjectilePortal</portalDef>
        <projectileDef>Projectile_CelstailBolt</projectileDef>
        <portalCount>5</portalCount>
        <portalDistance>2</portalDistance>
      </li>
      <li Class="MagicAndMyths.CompProperties_AbilityEffecterOnCaster">
        <effecterDef>MagicAndMyths_CelestialCastRune</effecterDef>
        <maintainForTicks>500</maintainForTicks>
        <scale>1</scale>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseMagicProjectile">
    <defName>Projectile_CelstailBolt</defName>
    <label>fireball</label>
    <thingClass>MagicAndMyths.Projectile_Extended</thingClass>
    <graphicData>
      <texPath>Projectiles/energyball_10</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <projectile>
      <damageDef>NatureFang</damageDef>
      <damageAmountBase>15</damageAmountBase>
      <explosionRadius>3.9</explosionRadius>
      <speed>50</speed>
      <arcHeightFactor>2</arcHeightFactor>
    </projectile>
    <comps>
      <li Class="MagicAndMyths.ProjectileCompProperties_ImpactAOEDamage">
        <damageDef>NatureFang</damageDef>
        <effecterDef>MagicAndMyths_EffectSingularityAura</effecterDef>
        <damageAmount>5</damageAmount>
        <radius>4</radius>
      </li>
    </comps>
  </ThingDef>







    <EffecterDef>
      <defName>MagicAndMyths_CelestialCastRune</defName>
      <children>
        <li>
          <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
          <scale>6</scale>
          <ticksBetweenMotes>20</ticksBetweenMotes>
          <positionLerpFactor>0</positionLerpFactor>
          <positionRadius>0</positionRadius>
          <moteDef>MagicAndMyths_CelestialMagicCircle</moteDef>
          <spawnLocType>OnSource</spawnLocType>
          <speed>0</speed>
          <angle>10~80</angle>
        </li>
        <li>
          <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
          <scale>6</scale>
          <ticksBetweenMotes>20</ticksBetweenMotes>
          <positionLerpFactor>0</positionLerpFactor>
          <positionRadius>0</positionRadius>
          <moteDef>MagicAndMyths_CelestialRuneOutline</moteDef>
          <spawnLocType>OnSource</spawnLocType>
          <speed>0</speed>
          <angle>0</angle>
          <rotation>0</rotation>
          <rotationRate>100</rotationRate>
        </li>
      </children>
    </EffecterDef>

  <ThingDef ParentName="MoteBase">
      <defName>MagicAndMyths_CelestialRuneOutline</defName>
      <thingClass>MoteThrown</thingClass>
      <graphicData>
        <graphicClass>Graphic_Mote</graphicClass>
        <shaderType>MoteGlow</shaderType>
        <texPath>MagicCircles/MagicCircleRuneOutline</texPath>
        <color>(50,0,100)</color>
      </graphicData>
      <altitudeLayer>Filth</altitudeLayer>
      <mote>
        <fadeInTime>0.5</fadeInTime>
        <solidTime>0.2</solidTime>
        <fadeOutTime>1</fadeOutTime>
        <growthRate>0.3</growthRate>
      </mote>
    </ThingDef>

    <ThingDef ParentName="MoteBase">
        <defName>MagicAndMyths_CelestialMagicCircle</defName>
        <thingClass>MoteAttached</thingClass>
        <graphicData>
          <graphicClass>Graphic_Mote</graphicClass>
          <shaderType>MoteGlow</shaderType>
          <texPath>MagicCircles/MagicCircle10</texPath>
          <color>(50,0,100)</color>
        </graphicData>
        <altitudeLayer>Filth</altitudeLayer>
        <mote>
          <fadeInTime>0.5</fadeInTime>
          <solidTime>0.2</solidTime>
          <fadeOutTime>1</fadeOutTime>
          <growthRate>0.3</growthRate>
        </mote>
      </ThingDef>

































      <!--Crush Damage Would be handy for this one (just a place holder)!-->

    <DamageDef>
      <defName>NatureFang</defName>
      <label>Nature Fang</label>
      <workerClass>DamageWorker_AddInjury</workerClass>
      <externalViolence>true</externalViolence>
      <deathMessage>{0} was ruthlessly torn apart by the primal force of Nature Fang.</deathMessage>
      <hediff>VerdantWound</hediff>
      <hediffSkin>VerdantWound</hediffSkin>
      <hediffSolid>Crack</hediffSolid>
      <armorCategory>Sharp</armorCategory>
      <impactSoundType>Slice</impactSoundType>
      <harmsHealth>true</harmsHealth>
    </DamageDef>

    <HediffDef ParentName="InjuryBase">
      <defName>VerdantWound</defName>
      <label>Verdant Wound</label>
      <labelNoun>a nature breathing wound</labelNoun>
      <description>A deep wound inflicted by nature breathing technique, infused with the force of wild harmony.</description>
      <comps>
        <li Class="HediffCompProperties_TendDuration">
          <severityPerDayTended>-0.68</severityPerDayTended>
        </li>
        <li Class="HediffCompProperties_Infecter">
          <infectionChance>0.45</infectionChance>
        </li>
      </comps>
      <injuryProps>
        <painPerSeverity>0.06</painPerSeverity>
        <averagePainPerSeverityPermanent>0.00825</averagePainPerSeverityPermanent>
        <bleedRate>0.09</bleedRate>
        <canMerge>true</canMerge>
        <destroyedLabel>Torn by nature</destroyedLabel>
        <destroyedOutLabel>Overgrown</destroyedOutLabel>
      </injuryProps>
    </HediffDef>
</Defs>
