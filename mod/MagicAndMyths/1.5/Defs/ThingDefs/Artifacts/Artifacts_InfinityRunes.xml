<Defs>
  <ThingDef ParentName="MMArtifactBase">
    <defName>MagicAndMyths_PowerAmethyst</defName>
    <label>power amethyst</label>
    <description>A magnificent violet crystal that pulses with raw energy, electricity seems to dance within its faceted depths. The magic of this amethyst can be invoked to unleash devastating destruction across a vast area, after which it cannot be used again, the amethyst will explode with immense force if destroyed.</description>
    <possessionCount>1</possessionCount>
    <orderedTakeGroup>Artifact</orderedTakeGroup>
    <drawerType>MapMeshAndRealTime</drawerType>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Artifacts/Materia_purple_high</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <soundInteract>Standard_Drop</soundInteract>
    <useHitPoints>true</useHitPoints>
    <soundDrop>Standard_Drop</soundDrop>
    <smeltable>false</smeltable>
    <statBases>
      <MarketValue>12000</MarketValue>
      <MaxHitPoints>50</MaxHitPoints>
      <Mass>0.01</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
  </ThingDef>

