<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <MagicAndMyths.GenStepDef_BspDungeon>
      <defName>GenerateUndeadDungeon</defName>
      <order>10000</order>
      <genStep Class="MagicAndMyths.GenStep_BspDungeon"/>
      <dungeonGenDef>UndeadDungeon</dungeonGenDef>
    </MagicAndMyths.GenStepDef_BspDungeon>

    <MagicAndMyths.DungeonGenDef>
      <defName>UndeadDungeon</defName>
        <randomCorridoorAmount>3</randomCorridoorAmount>
        <maxDepth>350</maxDepth>
        <roomSize>10</roomSize>
        <mapSize>(120, 1, 120)</mapSize>
        <minRoomPadding>3</minRoomPadding>
        <roomSizeFactor>1</roomSizeFactor>
        <noRoomChanceCriticalPath>0.1</noRoomChanceCriticalPath>
        <noRoomChanceSidePath>0.3</noRoomChanceSidePath>
        <minSizeMultiplier>1</minSizeMultiplier>
        <aspectRatioThreshold>1.13</aspectRatioThreshold>
        <edgeMarginDivisor>1.5</edgeMarginDivisor>
        <roomAmount>5~70</roomAmount>
        <sideRoomCount>9~25</sideRoomCount>
        <addRandomCorridoors>false</addRandomCorridoors>
        <availableRoomTypes>
          <li>
            <def>BasicFightRoom</def>
            <minSizeRequired>(10, 10)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
            </perferredLayouts>
          </li>
          <li>
            <def>ObstacleRoom</def>
            <minSizeRequired>(10, 10)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
            </perferredLayouts>
          </li>
        </availableRoomTypes>
        <availableSideRoomTypes>
          <li>
            <def>TreasureRoom_Basic</def>
            <minSizeRequired>(8, 8)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
              <li>Blob</li>
            </perferredLayouts>
          </li>
          <li>
            <def>TreasureRoom_MiningChunk</def>
            <minSizeRequired>(10, 10)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
              <li>Blob</li>
            </perferredLayouts>
          </li>
          <li>
            <def>BasicFightRoom</def>
            <minSizeRequired>(15, 15)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
              <li>Blob</li>
            </perferredLayouts>
          </li>
          <li>
            <def>RecoveryRoom</def>
            <minSizeRequired>(7, 6)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
              <li>Blob</li>
            </perferredLayouts>
          </li>
        </availableSideRoomTypes>
        <earlyAutomata>
        </earlyAutomata>
        <postGenAutomata>
        </postGenAutomata>
        <indestructibleWall>DungeonWall</indestructibleWall>
        <wall>DungeonWall</wall>
        <wallStuff>Uranium</wallStuff>
        <floor>MetalTile</floor>
        <largeDoor>Dungeon_SecurityDoor</largeDoor>
        <difficultyRange>1~1</difficultyRange>
        <genSteps>
          <li>ElevationFertility</li>
          <li>Terrain</li>
          <li>Plants</li>
          <li>GenerateUndeadDungeon</li>
        </genSteps>
        <pocketMapProperties>
            <biome>HiddenForest</biome>
            <temperature>21</temperature>
        </pocketMapProperties>
    </MagicAndMyths.DungeonGenDef>
</Defs>
