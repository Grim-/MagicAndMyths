<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicAndMyths.EncounterRoomDef_Fight>
    <defName>EncounterRoom_Fight</defName>
    <roomType>Normal</roomType>
    <minSize>(10,10)</minSize>
    <enemyCountRange>1~4</enemyCountRange>
    <possibleEnemies>
      <li>Bear_Grizzly</li>
    </possibleEnemies>
    <roomIsOnCriticalPath>true</roomIsOnCriticalPath>
  </MagicAndMyths.EncounterRoomDef_Fight>


  <MagicAndMyths.EncounterRoomDef_Fight>
    <defName>BasicFightRoom</defName>
    <label>combat encounter</label>
    <roomType>Normal</roomType>
    <roomIsOnCriticalPath>true</roomIsOnCriticalPath>
    <enemyCountRange>2~4</enemyCountRange>
    <perferredLayouts>
      <li>Circular</li>
    </perferredLayouts>
    <possibleEnemies>
      <li>WildBoar</li>
      <li>Warg</li>
      <li>Boomalope</li>
    </possibleEnemies>
    <useProgressionScaling>true</useProgressionScaling>
    <specificEncounters>
      <!-- 3 Boars - Early -->
      <li>
        <progressionRange>0.0~0.3</progressionRange>
        <weight>5</weight>
        <enemies>
          <li>
            <kindDef>WildBoar</kindDef>
            <maxAmount>3~3</maxAmount>
          </li>
        </enemies>
      </li>
      <!-- 2 Boars 1 Boomalope - Mid -->
      <li>
        <progressionRange>0.2~0.6</progressionRange>
        <weight>4</weight>
        <enemies>
          <li>
            <kindDef>WildBoar</kindDef>
            <maxAmount>2~2</maxAmount>
          </li>
          <li>
            <kindDef>Boomalope</kindDef>
            <maxAmount>1~1</maxAmount>
          </li>
        </enemies>
      </li>
      <!-- 2 Random 1 Golem - Late -->
      <li>
        <progressionRange>0.4~0.8</progressionRange>
        <weight>3</weight>
        <enemies>
          <li>
            <kindDef>WildBoar</kindDef>
            <maxAmount>1~2</maxAmount>
          </li>
          <li>
            <kindDef>Warg</kindDef>
            <maxAmount>0~1</maxAmount>
          </li>
          <li>
            <kindDef>Bear_Grizzly</kindDef>
            <maxAmount>1~1</maxAmount>
          </li>
        </enemies>
      </li>
      <!-- Pack of Wargs - Mid-Late -->
      <li>
        <progressionRange>0.3~0.7</progressionRange>
        <weight>3</weight>
        <enemies>
          <li>
            <kindDef>Warg</kindDef>
            <maxAmount>2~4</maxAmount>
          </li>
        </enemies>
      </li>
      <!-- Boomalope Herd - Early-Mid -->
      <li>
        <progressionRange>0.1~0.5</progressionRange>
        <weight>2</weight>
        <enemies>
          <li>
            <kindDef>Boomalope</kindDef>
            <maxAmount>3~5</maxAmount>
          </li>
        </enemies>
      </li>
    </specificEncounters>
  </MagicAndMyths.EncounterRoomDef_Fight>
</Defs>
