<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicAndMyths.EnchantDef>
    <defName>Enchant_ChainLightning</defName>
    <label>Enchantment of chaining</label>
    <description>An ancient magic chance on hit, trigger chain lightning, which will jump to X targets, dealing Y damage.</description>
    <commonality>1.0</commonality>
    <effects>
      <li Class="MagicAndMyths.EnchantEffectDef_ChainLightningOnHit">
        <maxJumps>5</maxJumps>
        <targetRadius>15</targetRadius>
        <damage>10</damage>
        <damageType>Lightning</damageType>
        <ticksBetweenJumps>25</ticksBetweenJumps>
        <lingerTicks>200</lingerTicks>
      </li>
    </effects>
    <allowedCategories>
      <li>EnchantCategory_Melee</li>
    </allowedCategories>
    <textColor>(0.8, 0, 0)</textColor>
  </MagicAndMyths.EnchantDef>
</Defs>
