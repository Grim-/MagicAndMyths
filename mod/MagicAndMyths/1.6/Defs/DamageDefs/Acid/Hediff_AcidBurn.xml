<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef ParentName="DebuffBase">
    <defName>MagicAndMyths_AcidBurn</defName>
    <label>acid burn</label>
    <description>A severe chemical burn caused by corrosive acid. The wound continues to bubble and burn, eating through flesh and any protective gear. The acid's ongoing corrosive action causes intense pain, bleeding, and rapidly degrades armor and clothing. This wound requires immediate medical attention to neutralize the acid and prevent further tissue damage.</description>
    <hediffClass>Hediff_Injury</hediffClass>
    <tendable>true</tendable>
    <displayWound>true</displayWound>
    <injuryProps>
      <bleedRate>0.012</bleedRate>
      <painPerSeverity>0.0125</painPerSeverity>
    </injuryProps>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Sharp>-0.175</ArmorRating_Sharp>
          <ArmorRating_Blunt>-0.175</ArmorRating_Blunt>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="EMF.HediffCompProperties_DamagePerInterval">
        <damageDef>Burn</damageDef>
        <damageAmount>1~1.3</damageAmount>
        <armourPenAmount>0.7~1</armourPenAmount>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2000</disappearsAfterTicks>
         <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
</Defs>
