<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicAndMyths.StackingHediffDef ParentName="InjuryBase">
    <defName>MagicAndMyths_ChillBlains</defName>
    <label>chillblains</label>
    <description>This pawn's extremities are inflamed and painful from cold exposure, causing swelling and reduced dexterity.</description>
    <hediffClass>MagicAndMyths.HediffInjuryWithStacks</hediffClass>
    <initialStacks>1</initialStacks>
    <maxStacks>5</maxStacks>
    <useStagesAsStackCount>true</useStagesAsStackCount>
    <stackGainRefreshesDisappearsDuration>true</stackGainRefreshesDisappearsDuration>
    <removeOnZeroStacks>true</removeOnZeroStacks>
    <injuryProps>
      <painPerSeverity>0.001</painPerSeverity>
      <bleedRate>0</bleedRate>
      <canMerge>true</canMerge>
      <destroyedLabel>rotted off</destroyedLabel>
      <destroyedOutLabel>frozen off</destroyedOutLabel>
    </injuryProps>
    <stages>
      <li>
        <label>mild</label>
        <statOffsets>
          <ArmorRating_Sharp>-0.05</ArmorRating_Sharp>
          <ArmorRating_Blunt>-0.05</ArmorRating_Blunt>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>moderate</label>
        <statOffsets>
          <ArmorRating_Sharp>-0.10</ArmorRating_Sharp>
          <ArmorRating_Blunt>-0.10</ArmorRating_Blunt>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>severe</label>
        <statOffsets>
          <ArmorRating_Sharp>-0.15</ArmorRating_Sharp>
          <ArmorRating_Blunt>-0.15</ArmorRating_Blunt>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.30</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>extreme</label>
        <statOffsets>
          <ArmorRating_Sharp>-0.20</ArmorRating_Sharp>
          <ArmorRating_Blunt>-0.20</ArmorRating_Blunt>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.40</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>crippling</label>
        <statOffsets>
          <ArmorRating_Sharp>-0.25</ArmorRating_Sharp>
          <ArmorRating_Blunt>-0.25</ArmorRating_Blunt>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.50</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>8000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </MagicAndMyths.StackingHediffDef>
</Defs>
