<?xml version="1.0" encoding="utf-8" ?>
<Defs>

   <!-- should also reduce sleep, food and comfort -->
  <HediffDef ParentName="DebuffBase">
    <defName>MagicAndMyths_Wet</defName>
    <label>wet</label>
    <description>This pawn is soaking wet, they will tire more easily and are more susceptible to lightning attacks.</description>
    <hediffClass>Hediff_Injury</hediffClass>
    <injuryProps>
      <painPerSeverity>0.0001</painPerSeverity>
      <bleedRate>0</bleedRate>
      <canMerge>true</canMerge>
      <destroyedLabel>blown off with high pressure</destroyedLabel>
      <destroyedOutLabel>blown out with high pressure</destroyedOutLabel>
    </injuryProps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
        <statFactors>
          <Flammability>0</Flammability>
        </statFactors>
        <statOffsets>
          <MoveSpeed>-0.1</MoveSpeed>
          <ComfyTemperatureMax>10</ComfyTemperatureMax>
          <ImmunityGainSpeed>-0.1</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="EMF.HediffCompProperties_ComboReactor">
        <damageReactions>
          <li>
            <reactionDamageType>
              <li>Lightning</li>
            </reactionDamageType>
            <workerClass>EMF.ComboReactionWorker_Stun</workerClass>
            <reactionProperties Class="EMF.StunReactionProperties">
              <stunTicks>500</stunTicks>
            </reactionProperties>
            <reactionEffecter>Impact_Toxic</reactionEffecter>
          </li>
          <li>
            <reactionDamageType>
              <li>Lightning</li>
            </reactionDamageType>
            <workerClass>EMF.ComboReactionWorker_DealDamage</workerClass>
            <reactionProperties>
              <damageDef>Lightning</damageDef>
              <damageRange>2~3</damageRange>
              <armourpenRange>0.1</armourpenRange>
              <isAOE>true</isAOE>
              <radius>2</radius>
              <!-- <friendlyFireSettings>
                <canTargetHostile>true</canTargetHostile>
                <canTargetFriendly>false</canTargetFriendly>
                <canTargetNeutral>false</canTargetNeutral>
              </friendlyFireSettings> -->
            </reactionProperties>
            <reactionEffecter>Impact_Toxic</reactionEffecter>
          </li>
        </damageReactions>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>6000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>
</Defs>
