<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <AbilityDef>
    <defName>MagicAndMyths_LeapSlam</defName>
    <label>leap slam</label>
    <description>Leap to the target location slamming your weapon down dealing weapon damage in a radius around your landing location.</description>
    <iconPath>Projectiles/Projectile_Fireball</iconPath>
    <cooldownTicksRange>6000</cooldownTicksRange>
    <category>Sanguophage</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>15</range>
      <warmupTime>0.1</warmupTime>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetItems>true</canTargetItems>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="EMF.CompProperties_DamageImpact">
        <landingRadius>3</landingRadius>
        <landingEffecterDef>MagicAndMyths_GroundCrater</landingEffecterDef>
        <damageParameters>
          <useWeaponDamageIfAvailable>true</useWeaponDamageIfAvailable>
          <weaponDamageMult>1.2~1.5</weaponDamageMult>
          <armourPenAmount>0.15~0.25</armourPenAmount>
        </damageParameters>
        <friendlyFireSettings>
          <canTargetHostile>true</canTargetHostile>
          <canTargetFriendly>false</canTargetFriendly>
          <canTargetNeutral>true</canTargetNeutral>
          <canTargetSelf>false</canTargetSelf>
        </friendlyFireSettings>
      </li>
      <li Class="EMF.CompProperties_StunImpact">
        <landingRadius>2</landingRadius>
        <stunTicks>120</stunTicks>
        <friendlyFireSettings>
          <canTargetHostile>true</canTargetHostile>
          <canTargetFriendly>false</canTargetFriendly>
          <canTargetNeutral>true</canTargetNeutral>
          <canTargetSelf>false</canTargetSelf>
        </friendlyFireSettings>
      </li>
    </comps>
  </AbilityDef>
</Defs>
