<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>Spellblade_FireStanceHediff</defName>
    <label>Fire Stance</label>
    <description>Channeling aggressive fire magic. Attacks deal additional burn damage.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>1.0</MoveSpeed>
          <MeleeHitChance>0.1</MeleeHitChance>
          <MeleeDodgeChance>-0.05</MeleeDodgeChance>
          <ComfyTemperatureMax>100</ComfyTemperatureMax>
        </statOffsets>
        <statFactors>
          <Stat_ManaRegen>0.80</Stat_ManaRegen>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="EMF.HediffCompProperties_OnMeleeAttackAddHediff">
        <hediffDef>Burn</hediffDef>
        <intialSeverity>0.1</intialSeverity>
        <severityIncrease>0.1</severityIncrease>
        <chanceToApply>0.5</chanceToApply>
      </li>
      <li Class="EMF.HediffCompProperties_OnMeleeAttackDealDamageResourceBoost">
        <damage>2~4</damage>
        <damageDef>Flame</damageDef>
        <chance>1</chance>
        <armourPen>0~0.5</armourPen>
        <useWeaponDamage>true</useWeaponDamage>
        <weaponDamageMultiplier>1.2</weaponDamageMultiplier>
        <weaponArmourPen>0~0.5</weaponArmourPen>
        <!-- damage boost for resource stuff -->
        <resourceToUse>Mana</resourceToUse>
        <resourceCost>15</resourceCost>
        <damageMutlplier>1.15</damageMutlplier>
        <damageFlatAmount>1</damageFlatAmount>
      </li>
    </comps>
  </HediffDef>
</Defs>
