<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <AbilityDef>
    <defName>MagicAndMyths_Fireball</defName>
    <label>Fireball</label>
    <description>Use a hemogenic chemical reaction to launch a bony spine at the target. The spine exits through the skin from an opening between the collarbones. Given the method of launch, it is surprisingly easy to aim.</description>
    <iconPath>Projectiles/Projectile_Fireball</iconPath>
    <cooldownTicksRange>6000</cooldownTicksRange>
    <category>Sanguophage</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>20</range>
      <warmupTime>0.5</warmupTime>
      <soundCast>PiercingSpine_Launch</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetItems>true</canTargetItems>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MagicAndMyths.CompProperties_LaunchProjectileExtended">
        <projectileDef>Projectile_Fireball</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseMagicProjectile">
    <defName>Projectile_Fireball</defName>
    <label>fireball</label>
    <thingClass>MagicAndMyths.Projectile_Extended</thingClass>
    <graphicData>
      <texPath>Projectiles/Projectile_Fireball</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Burn</damageDef>
      <damageAmountBase>15</damageAmountBase>
      <explosionRadius>3.9</explosionRadius>
      <speed>50</speed>
      <arcHeightFactor>2</arcHeightFactor>
    </projectile>
    <comps>
      <li Class="MagicAndMyths.ProjectileCompProperties_ImpactAOEDamage">
        <damageDef>Burn</damageDef>
        <effecterDef>MagicAndMyths_Explosion</effecterDef>
        <damageAmount>5</damageAmount>
        <radius>4</radius>
      </li>
      <li Class="MagicAndMyths.ProjectileCompProperties_ImpactStartOrStopFires">
          <effecterDef>MagicAndMyths_ExplosionThree</effecterDef>
      </li>
    </comps>
  </ThingDef>

  <MagicAndMyths.LevelingResourceAbilityDef>
    <defName>MagicAndMyths_Fireball_Leveling</defName>
    <label>Fireballwww</label>
    <description>Use a hemogenic chemical reaction to launch a bony spine at the target. The spine exits through the skin from an opening between the collarbones. Given the method of launch, it is surprisingly easy to aim.</description>
    <iconPath>Projectiles/Projectile_Fireball</iconPath>
    <cooldownTicksRange>6000</cooldownTicksRange>
    <category>Sanguophage</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>

    <!-- Resource settings -->
    <resourceDef>Mana</resourceDef>
    <resourceCost>30</resourceCost>
    <baseExperienceGain>20</baseExperienceGain>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>20</range>
      <warmupTime>0.5</warmupTime>
      <soundCast>PiercingSpine_Launch</soundCast>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetItems>true</canTargetItems>
      </targetParams>
    </verbProperties>

    <!-- Base ability comps (used by Level 1 ONLY) -->
    <comps>
      <li Class="MagicAndMyths.CompProperties_LaunchProjectileExtended">
        <projectileDef>Projectile_Fireball</projectileDef>
        <launchAmount>1</launchAmount>
      </li>
    </comps>

    <levels>
      <!-- Level 1: Single fireball (uses base comps) -->
      <li>
        <labelSuffix>(Novice)</labelSuffix>
        <experienceRequired>0</experienceRequired>
      </li>

      <!-- Level 2: Double fireball-->
      <li>
        <labelSuffix>(Adept)</labelSuffix>
        <experienceRequired>150</experienceRequired>
        <resourceCostMultiplier>1.3</resourceCostMultiplier>
        <levelComps>
          <li Class="MagicAndMyths.CompProperties_LaunchProjectileExtended">
            <projectileDef>Projectile_Death</projectileDef>
            <launchAmount>2</launchAmount>
          </li>
        </levelComps>
      </li>
    </levels>
  </MagicAndMyths.LevelingResourceAbilityDef>
</Defs>
