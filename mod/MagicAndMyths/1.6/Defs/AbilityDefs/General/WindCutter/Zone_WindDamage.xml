<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <EMF.ActiveZoneDef ParentName="EtherealThingBase">
    <defName>WindZone</defName>
    <label>wind zone</label>
    <description>An invisible zone of cutting winds.</description>
    <thingClass>EMF.ActiveZone</thingClass>
    <category>Ethereal</category>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Weather</altitudeLayer>
    <comps>
      <li Class="EMF.CompProperties_ActiveZoneDamage">
        <ticksBetweenDamage>60</ticksBetweenDamage>
        <damageParms>
          <damageDef>Cut</damageDef>
          <damageAmount>3~5</damageAmount>
        </damageParms>
      </li>
    </comps>
  </EMF.ActiveZoneDef>
</Defs>
