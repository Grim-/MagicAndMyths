<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <AbilityDef>
    <defName>MagicAndMyths_YamatoTeleport</defName>
    <label>Yamato Portal</label>
    <description>Use the yamato to cut through space and open a portal to any position on the map</description>
    <iconPath>Projectiles/Projectile_Fireball</iconPath>
    <cooldownTicksRange>1400</cooldownTicksRange>
    <category>Sanguophage</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>100</range>
      <warmupTime>0.1</warmupTime>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetItems>true</canTargetItems>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="MagicAndMyths.CompProperties_AbilityTeleport">
        <delayTicks>40</delayTicks>
        <originEffecter>MagicAndMyths_Portal</originEffecter>
        <destinationEffecter>MagicAndMyths_Portal</destinationEffecter>
      </li>
    </comps>
  </AbilityDef>

</Defs>
