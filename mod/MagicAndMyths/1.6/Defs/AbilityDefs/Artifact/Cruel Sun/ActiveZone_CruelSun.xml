<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <EMF.ActiveZoneDef ParentName="EtherealThingBase">
    <defName>MagicAndMyths_CruelSun</defName>
    <label>Cruel sun</label>
    <description>a sun.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>VFX/Cruelsun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <size>(2,2)</size>
    <costList>
      <Steel>1</Steel>
    </costList>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
    </building>
    <zoneColor>(1,0,0)</zoneColor>
    <comps>
      <li Class="CompProperties_RadialPulse">
          <color>(150, 0, 237, 255)</color>
          <radius>3</radius>
      </li>
      <li Class="EMF.CompProperties_ActiveZoneDamage">
        <ticksBetweenDamage>30</ticksBetweenDamage>
        <damageParms>
          <damageDef>Burn</damageDef>
          <damageAmount>1~3</damageAmount>
        </damageParms>
      </li>
      <li Class="EMF.CompProperties_ActiveZoneStartFires">
        <ticksBetweenFires>120</ticksBetweenFires>
        <fireAmount>0.2~0.7</fireAmount>
        <coverage>0.7~1</coverage>
        <extinguishAllFiresOnDestroy>true</extinguishAllFiresOnDestroy>
      </li>
    </comps>
