      <li Class="EMF.ProjectileCompProperties_ImpactAOEDamage">
        <damageDef>Burn</damageDef>
        <effecterDef>MagicAndMyths_Explosion</effecterDef>
        <damageAmount>5</damageAmount>
        <radius>4</radius>
      </li>
      <li Class="EMF.ProjectileCompProperties_ImpactStartOrStopFires">
          <effecterDef>MagicAndMyths_ExplosionThree</effecterDef>
      </li>
    </comps>
  </ThingDef>
