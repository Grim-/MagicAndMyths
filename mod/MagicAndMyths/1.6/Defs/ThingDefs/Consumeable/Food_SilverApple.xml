<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="MealBase">
    <defName>MagicAndMyths_SilverApple</defName>
    <label>silver apple</label>
    <description>A beautiful apple with a skin of brilliant silver, it produces a slight euphoric affect when eaten.</description>
    <graphicData>
      <texPath>Resources/Apple</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <DeteriorationRate>0.25</DeteriorationRate>
      <MarketValue>3000</MarketValue>
      <Mass>0.7</Mass>
      <WorkToMake>450</WorkToMake>
      <Nutrition>1</Nutrition>
      <Beauty>20</Beauty>
    </statBases>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <optimalityOffsetHumanlikes>-5</optimalityOffsetHumanlikes>
      <optimalityOffsetFeedingAnimals>-10</optimalityOffsetFeedingAnimals>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <specialThoughtDirect>MagicAndMyths_SilverAppleEuphoria</specialThoughtDirect>
      <outcomeDoers>
        <!-- <li Class="MagicAndMyths.IngestionOutcomeDoer_GiveHediff">
            <hediffDef></hediffDef>
            <severity>1</severity>
        </li> -->
      </outcomeDoers>
    </ingestible>
    <allowedArchonexusCount>40</allowedArchonexusCount>
  </ThingDef>

  <ThoughtDef>
    <defName>MagicAndMyths_SilverAppleEuphoria</defName>
    <durationDays>1.0</durationDays>
    <stackLimit>1</stackLimit>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>strange euphoric feeling</label>
        <description>I feel strange, but also very relaxed.</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
