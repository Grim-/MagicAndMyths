    <MagicAndMyths.DungeonGenDef>
      <defName>UndeadDungeon</defName>
        <randomCorridoorAmount>3</randomCorridoorAmount>
        <maxDepth>250</maxDepth>
        <roomSize>10</roomSize>
        <roomSizeFactor>1.0</roomSizeFactor>
        <mapSize>(150, 1, 150)</mapSize>
        <minRoomPadding>1</minRoomPadding>
        <noRoomChanceCriticalPath>0.1</noRoomChanceCriticalPath>
        <noRoomChanceSidePath>0.3</noRoomChanceSidePath>
        <roomAmount>10</roomAmount>
        <sidePathLength>1~6</sidePathLength>
        <sideRoomCount>20~25</sideRoomCount>
         <allowHiddenSidePaths>true</allowHiddenSidePaths>
         <hiddenSidePathChance>0.3</hiddenSidePathChance>
         <longSidePathChance>0.4</longSidePathChance>
         <meanderingChance>0.3</meanderingChance>
         <allowBranchingSidePaths>true</allowBranchingSidePaths>
         <branchingChance>0.7</branchingChance>
         <maxSidePathBranches>4</maxSidePathBranches>
        <addRandomCorridoors>false</addRandomCorridoors>
        <availableRoomTypes>
          <li>
            <def>BasicFightRoom</def>
            <minSizeRequired>(10, 10)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
              <li>Blob</li>
            </perferredLayouts>
          </li>
          <li>
            <def>ObstacleRoom</def>
            <minSizeRequired>(10, 10)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
              <li>Blob</li>
            </perferredLayouts>
          </li>
        </availableRoomTypes>
        <availableSideRoomTypes>
          <li>
            <def>EmptyRoom</def>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
              <li>Blob</li>
            </perferredLayouts>
          </li>
          <li>
            <def>TreasureRoom_Basic</def>
            <minSizeRequired>(8, 8)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
              <li>Blob</li>
            </perferredLayouts>
          </li>
          <li>
            <def>TreasureRoom_MiningChunk</def>
            <minSizeRequired>(10, 10)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
              <li>Blob</li>
            </perferredLayouts>
          </li>
          <li>
            <def>BasicFightRoom</def>
            <minSizeRequired>(15, 15)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
              <li>Blob</li>
            </perferredLayouts>
          </li>
          <li>
            <def>RecoveryRoom</def>
            <minSizeRequired>(7, 6)</minSizeRequired>
            <perferredLayouts>
              <li>Square</li>
              <li>Circular</li>
              <li>Blob</li>
            </perferredLayouts>
          </li>
        </availableSideRoomTypes>
        <earlyAutomata>
        </earlyAutomata>
        <postGenAutomata>
        </postGenAutomata>
        <indestructibleWall>DungeonWall</indestructibleWall>
        <wall>DungeonWall</wall>
        <wallStuff>Uranium</wallStuff>
        <floor>MetalTile</floor>
        <largeDoor>Dungeon_SecurityDoor</largeDoor>
        <difficultyRange>1~1</difficultyRange>
        <genSteps>
          <li>Terrain</li>
        </genSteps>
        <pocketMapProperties>
            <biome>HiddenForest</biome>
            <temperature>21</temperature>
        </pocketMapProperties>
    </MagicAndMyths.DungeonGenDef>
</Defs>
