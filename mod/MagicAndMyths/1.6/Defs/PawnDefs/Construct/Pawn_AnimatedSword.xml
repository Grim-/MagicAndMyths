<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="AnimalThingBase">
      <defName>MagicAndMyths_AnimatedSword</defName>
      <label>animated sword</label>
      <description>wwwwww.</description>
      <race>
        <body>AnimatedWeaponBody</body>
        <predator>false</predator>
        <maxPreyBodySize>0</maxPreyBodySize>
        <baseBodySize>0.25</baseBodySize>
        <baseHungerRate>0</baseHungerRate>
        <baseHealthScale>1</baseHealthScale>
        <foodType>CarnivoreAnimal, OvivoreAnimal</foodType>
        <leatherDef>Leather_Lizard</leatherDef>
        <meatLabel>cobra meat</meatLabel>
        <petness>1</petness>
        <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
        <manhunterOnDamageChance>0</manhunterOnDamageChance>
        <nameOnTameChance>1</nameOnTameChance>
        <lifeExpectancy>2000</lifeExpectancy>
        <lifeStageAges>
          <li>
            <def>AnimalBaby</def>
            <minAge>0</minAge>
          </li>
        </lifeStageAges>
        <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
        <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
        <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
        <soundEating>Reptile_Eat</soundEating>
        <headPosPerRotation>
          <li>(-0.03, 0, 0.35)</li>
          <li>(0.03, 0, 0.36)</li>
          <li>(-0.05, 0, 0.28)</li>
          <li>(-0.03, 0, 0.36)</li>
        </headPosPerRotation>
      </race>
      <tools>
        <li>
          <label>blade</label>
          <capacities>
            <li>Cut</li>
          </capacities>
          <power>2</power>
          <cooldownTime>1.5</cooldownTime>
        </li>
        <li>
          <label>pommel</label>
          <capacities>
            <li>Blunt</li>
          </capacities>
          <power>1</power>
          <cooldownTime>1.5</cooldownTime>
          <chanceFactor>0.2</chanceFactor>
        </li>
      </tools>
      <modExtensions>
        <li MayRequire="com.emo.squads" Class="SquadBehaviour.SquadMemberExtension">
          <canEverJoinSquad>true</canEverJoinSquad>
          <overrideDefaultChecks>true</overrideDefaultChecks>
        </li>
      </modExtensions>
    </ThingDef>

    <BodyDef>
      <defName>AnimatedWeaponBody</defName>
      <label>animated weapon</label>
      <corePart>
        <def>AnimatedCore</def>
        <height>Middle</height>
        <depth>Outside</depth>
        <groups>
          <li>Torso</li>
        </groups>
      </corePart>
    </BodyDef>

    <BodyPartDef>
      <defName>AnimatedCore</defName>
      <label>animated core</label>
      <hitPoints>50</hitPoints>
      <skinCovered>false</skinCovered>
      <solid>true</solid>
      <bleedRate>0</bleedRate>
      <canScarify>false</canScarify>
      <canSuggestAmputation>false</canSuggestAmputation>
      <executionPartPriority>500</executionPartPriority>
      <tags>
        <li>ConsciousnessSource</li>
        <li>BloodPumpingSource</li>
        <li>BreathingSource</li>
        <li>SightSource</li>
        <li>HearingSource</li>
        <li>ManipulationLimbCore</li>
        <li>MovingLimbCore</li>
      </tags>
      <alive>false</alive>
    </BodyPartDef>

    <PawnKindDef ParentName="AnimalKindBase">
      <defName>MagicAndMyths_AnimatedSword</defName>
      <label>animated sword</label>
      <labelPlural>animated swords</labelPlural>
      <race>MagicAndMyths_AnimatedSword</race>
      <combatPower>40</combatPower>
      <lifeStages>
        <li>
          <bodyGraphicData>
            <texPath>Pawns/AnimatedSword/AnimatedSword</texPath>
            <drawSize>1.95</drawSize>
            <shadowData>
              <volume>(0.3, 0.4, 0.3)</volume>
              <offset>(0,0,-0.15)</offset>
            </shadowData>
          </bodyGraphicData>
          <dessicatedBodyGraphicData>
            <texPath>Pawns/AnimatedSword/AnimatedSword</texPath>
            <drawSize>1.95</drawSize>
          </dessicatedBodyGraphicData>
        </li>
      </lifeStages>
