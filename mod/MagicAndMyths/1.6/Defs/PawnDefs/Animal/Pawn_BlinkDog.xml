<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="ThingBaseWolf">
    <defName>Blink_Hound</defName>
    <label>blink hound</label>
    <thingClass>MagicAndMyths.BlinkDog</thingClass>
    <description>A mystical predator capable of short-range teleportation. These intelligent pack hunters can phase in and out of reality, making them formidable and unpredictable opponents.</description>
    <race>
      <meatLabel>blink hound meat</meatLabel>
      <renderTree>AnimalColored</renderTree>
      <specialTrainables>
        <li>Obedience</li>
        <li>Release</li>
        <li>Rescue</li>
        <li>AttackTarget</li>
        <li>Dig</li>
      </specialTrainables>
    </race>
    <comps>
      <li Class="EMF.CompProperties_PawnEvolvable">
        <evolutionChamberDef>MagicAndMyths_ManaEgg</evolutionChamberDef>
      </li>
    </comps>
  </ThingDef>

