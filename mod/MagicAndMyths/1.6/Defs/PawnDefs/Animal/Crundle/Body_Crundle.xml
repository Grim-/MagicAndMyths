<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <BodyDef>
    <defName>Imp</defName>
    <label>imp</label>
    <corePart>
      <def>Imp_Torso</def>
      <height>Bottom</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>Spine</def>
          <coverage>0.05</coverage>
          <depth>Inside</depth>
          <groups><li>Torso</li></groups>
        </li>
        <li>
          <def>Heart</def>
          <coverage>0.04</coverage>
          <depth>Inside</depth>
          <groups><li>Torso</li></groups>
        </li>
        <li>
          <def>Lung</def>
          <customLabel>left lung</customLabel>
          <coverage>0.05</coverage>
          <depth>Inside</depth>
          <groups><li>Torso</li></groups>
        </li>
        <li>
          <def>Lung</def>
          <customLabel>right lung</customLabel>
          <coverage>0.05</coverage>
          <depth>Inside</depth>
          <groups><li>Torso</li></groups>
        </li>
        <li>
          <def>Imp_Neck</def>
          <coverage>0.15</coverage>
          <height>Top</height>
          <parts>
            <li>
              <def>Imp_Head</def>
              <coverage>0.80</coverage>
              <groups>
                <li>UpperHead</li>
                <li>FullHead</li>
              </groups>
              <parts>
                <li>
                  <def>Skull</def>
                  <coverage>0.25</coverage>
                  <depth>Inside</depth>
                  <parts>
                    <li>
                      <def>Brain</def>
                      <coverage>0.7</coverage>
                    </li>
                  </parts>
                </li>
                <li>
                  <def>Imp_Horn</def>
                  <customLabel>left horn</customLabel>
                  <coverage>0.15</coverage>
                </li>
                <li>
                  <def>Imp_Horn</def>
                  <customLabel>right horn</customLabel>
                  <coverage>0.15</coverage>
                </li>
                <li>
                  <def>Jaw</def>
                  <coverage>0.15</coverage>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>Imp_Arm</def>
          <customLabel>left arm</customLabel>
          <coverage>0.15</coverage>
          <parts>
            <li>
              <def>Imp_Hand</def>
              <customLabel>left hand</customLabel>
              <coverage>0.20</coverage>
              <parts>
                <li>
                  <def>Imp_Claw</def>
                  <customLabel>left claw</customLabel>
                  <coverage>0.15</coverage>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>Imp_Arm</def>
          <customLabel>right arm</customLabel>
          <coverage>0.15</coverage>
          <parts>
            <li>
              <def>Imp_Hand</def>
              <customLabel>right hand</customLabel>
              <coverage>0.20</coverage>
              <parts>
                <li>
                  <def>Imp_Claw</def>
                  <customLabel>right claw</customLabel>
                  <coverage>0.15</coverage>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>Imp_Tail</def>
          <coverage>0.15</coverage>
        </li>
        <li>
          <def>Imp_Leg</def>
          <customLabel>left leg</customLabel>
          <coverage>0.14</coverage>
          <parts>
            <li>
              <def>Imp_Foot</def>
              <customLabel>left foot</customLabel>
              <coverage>0.1</coverage>
            </li>
          </parts>
        </li>
        <li>
          <def>Imp_Leg</def>
          <customLabel>right leg</customLabel>
          <coverage>0.14</coverage>
          <parts>
            <li>
              <def>Imp_Foot</def>
              <customLabel>right foot</customLabel>
              <coverage>0.1</coverage>
            </li>
          </parts>
        </li>
      </parts>
    </corePart>
  </BodyDef>

  <BodyPartDef>
    <defName>Imp_Torso</defName>
    <label>torso</label>
    <hitPoints>30</hitPoints>
    <skinCovered>true</skinCovered>
  </BodyPartDef>

  <BodyPartDef>
    <defName>Imp_Neck</defName>
    <label>neck</label>
    <hitPoints>20</hitPoints>
    <skinCovered>true</skinCovered>
  </BodyPartDef>

  <BodyPartDef>
    <defName>Imp_Head</defName>
